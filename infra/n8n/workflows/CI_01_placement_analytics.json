{
  "name": "CI_01_Placement_Analytics",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 0
            }
          ]
        }
      },
      "id": "schedule-trigger-001",
      "name": "Nightly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "operation": "getAll",
        "schema": "public",
        "table": "career_twins",
        "limit": 500
      },
      "id": "supabase-fetch-twins-002",
      "name": "Fetch All Twins",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [300, 300]
    },
    {
      "parameters": {
        "jsCode": "const twins = $input.all().map(i => i.json);\nlet totalReadiness = 0;\nlet atRiskCount = 0;\ntwins.forEach(t => {\n  totalReadiness += t.readiness_score;\n  if (t.readiness_score < 40) atRiskCount++;\n});\nconst avgReadiness = totalReadiness / twins.length;\nreturn { json: { avg_readiness: avgReadiness, total_students: twins.length, at_risk: atRiskCount } };"
      },
      "id": "code-aggregate-003",
      "name": "Aggregate Metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "college_analytics_cache",
        "columns": "metric_type, data",
        "metric_type": "placement_readiness",
        "data": "={{ JSON.stringify($json) }}"
      },
      "id": "supabase-save-analytics-004",
      "name": "Update Analytics Cache",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Nightly Schedule": {
      "main": [
        [
          {
            "node": "Fetch All Twins",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch All Twins": {
      "main": [
        [
          {
            "node": "Aggregate Metrics",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Metrics": {
      "main": [
        [
          {
            "node": "Update Analytics Cache",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
