{
  "name": "CI_04_Recruiter_Analytics",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 3
            }
          ]
        }
      },
      "id": "schedule-trigger-001",
      "name": "Nightly Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "schema": "public",
        "table": "applications",
        "limit": 500
      },
      "id": "supabase-fetch-applications-002",
      "name": "Fetch Applications",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        300,
        200
      ]
    },
    {
      "parameters": {
        "operation": "getAll",
        "schema": "public",
        "table": "interviews",
        "limit": 500
      },
      "id": "supabase-fetch-interviews-003",
      "name": "Fetch Interviews",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        300,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const apps = $items(\"Fetch Applications\").map(i => i.json);\nconst interviews = $items(\"Fetch Interviews\").map(i => i.json);\n\nlet totalApps = apps.length;\nlet totalInterviews = interviews.length;\nlet offerConversions = apps.filter(a => a.status === 'hired').length;\n\nreturn { json: { total_applications: totalApps, total_interviews: totalInterviews, total_offers: offerConversions } };"
      },
      "id": "code-aggregate-activity-004",
      "name": "Aggregate Activity",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": "public",
        "table": "college_analytics_cache",
        "columns": "metric_type, data",
        "metric_type": "recruiter_activity",
        "data": "={{ JSON.stringify($json) }}"
      },
      "id": "supabase-save-activity-005",
      "name": "Update Analytics Cache",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    }
  ],
  "connections": {
    "Nightly Schedule": {
      "main": [
        [
          {
            "node": "Fetch Applications",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Interviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Applications": {
      "main": [
        [
          {
            "node": "Aggregate Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Interviews": {
      "main": [
        [
          {
            "node": "Aggregate Activity",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Aggregate Activity": {
      "main": [
        [
          {
            "node": "Update Analytics Cache",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "errorWorkflow": "99_global_error_handler"
  }
}