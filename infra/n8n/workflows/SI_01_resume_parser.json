{
  "name": "SI_01_Resume_Agent",
  "nodes": [
    {
      "parameters": {},
      "id": "execute-workflow-trigger-001",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [100, 300]
    },
    {
      "parameters": {
        "url": "={{ $json.resume_url }}",
        "options": {}
      },
      "id": "http-fetch-pdf-002",
      "name": "Fetch Resume PDF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [300, 300]
    },
    {
      "parameters": {
        "operation": "text",
        "sourceKey": "data",
        "destinationKey": "resume_text"
      },
      "id": "read-pdf-003",
      "name": "Extract PDF Text",
      "type": "n8n-nodes-base.readPDF",
      "typeVersion": 1,
      "position": [500, 300]
    },
    {
      "parameters": {
        "model": "gemini-2.5-flash",
        "messages": {
          "messageValues": [
            {
              "message": "=You are an expert technical recruiter and ATS parser.\nExtract the following from the text:\n1. Core Skills (List of strings)\n2. Years of Experience (Integer)\n3. ATS Score (0-100 based on clarity, impact, and formatting)\nRespond ONLY in strict JSON format.\n\nResume Text:\n{{ $json.resume_text }}"
            }
          ]
        },
        "options": {
          "responseFormat": "json_object"
        }
      },
      "id": "gemini-parse-004",
      "name": "Gemini Parse & Score",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1,
      "position": [700, 300]
    },
    {
      "parameters": {
        "operation": "upsert",
        "collection": "student_resumes",
        "text": "={{ $json.resume_text }}",
        "metadata": "={{ $json.gemini_output }}"
      },
      "id": "qdrant-upsert-005",
      "name": "Upsert to Qdrant",
      "type": "n8n-nodes-base.qdrant",
      "typeVersion": 1,
      "position": [900, 200]
    },
    {
      "parameters": {
        "operation": "update",
        "schema": "public",
        "table": "student_profiles",
        "updateKey": "id",
        "updateValue": "={{ $json.student_id }}",
        "columns": "skills, ats_score",
        "skills": "={{ $json.gemini_output.skills }}",
        "ats_score": "={{ $json.gemini_output.ats_score }}"
      },
      "id": "supabase-update-006",
      "name": "Update Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [900, 400]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [
        [
          {
            "node": "Fetch Resume PDF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Resume PDF": {
      "main": [
        [
          {
            "node": "Extract PDF Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract PDF Text": {
      "main": [
        [
          {
            "node": "Gemini Parse & Score",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini Parse & Score": {
      "main": [
        [
          {
            "node": "Upsert to Qdrant",
            "type": "main",
            "index": 0
          },
          {
            "node": "Update Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
